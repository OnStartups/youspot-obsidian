{
  "name": "@youspot/obsidian",
  "version": "0.1.2",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/build.ts --watch",
    "build": "bun run scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint:obsidian": "eslint src",
    "test": "bun test test/",
    "install:dev": "bun run scripts/build.ts && bun run scripts/install-dev.ts",
    "version": "bun run scripts/version-bump.ts",
    "clean": "rm -rf dist .turbo node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.9.1",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.13.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0"
  },
  "description": "Two-way sync between an Obsidian vault folder and your YouSpot Brain.",
  "repository": {
    "type": "git",
    "url": "https://github.com/OnStartups/youspot-obsidian.git"
  },
  "license": "MIT"
}
